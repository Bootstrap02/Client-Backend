# ---- Server ----
PORT=3000
NODE_ENV=development            # set to "production" on Render

# ---- Database (put the database name before the "?", e.g. /rarwater) ----
DATABASE_URI=mongodb+srv://<user>:<password>@<cluster>.mongodb.net/rarwater?retryWrites=true&w=majority

# ---- REQUIRED: the API refuses to start without these two ----
# Example values below were freshly generated - generate your own with: openssl rand -hex 32
JWT_SECRET=381f6ad5b199d147ec2f779dd1208d7f1eeb1bf1fbc182999307696a6ab0012a
OWNER_EMAIL=owner@example.com
# Protects backend-only client onboarding/platform APIs (was called ADMIN_API_KEY)
PLATFORM_ADMIN_API_KEY=3018134113eb6dd9e492a64813a148de4c9c104103a6eee2450e10111931f7c3

# ---- Default client (Rosita Waters) ----
DEFAULT_TENANT_KEY=rosita-waters
DEFAULT_TENANT_NAME=Rosita Waters
# bare hostnames of the customer website (localhost is added automatically in development)
DEFAULT_TENANT_DOMAINS=rositawaters.com,www.rositawaters.com,rosita-waters-react.vercel.app,rosita-waters.vercel.app
# dummy number used until the owner sets a real one in Admin > Website settings
DEFAULT_WHATSAPP_NUMBER=2348000000000

# ---- Images (Cloudinary). Works for the default client; other clients use TENANT_<KEY>_CLOUDINARY_URL ----
CLOUDINARY_URL=cloudinary://<api_key>:<api_secret>@<cloud_name>

# ---- Email via Resend (password OTPs + order emails) - these MUST carry the tenant prefix ----
TENANT_ROSITA_WATERS_RESEND_API_KEY=re_your_key
TENANT_ROSITA_WATERS_RESEND_FROM_EMAIL=admin@yourverifieddomain.com
# where new orders are emailed (defaults to OWNER_EMAIL if left out)
TENANT_ROSITA_WATERS_ORDER_NOTIFICATION_EMAIL=orders@example.com

# ---- Optional: automatic WhatsApp order message via Meta WhatsApp Cloud API ----
# TENANT_ROSITA_WATERS_WHATSAPP_ACCESS_TOKEN=
# TENANT_ROSITA_WATERS_WHATSAPP_PHONE_NUMBER_ID=
# TENANT_ROSITA_WATERS_WHATSAPP_ORDER_RECIPIENT=2348000000000

# ---- CORS: browser origins allowed to call the API (admin portal + storefront) ----
ALLOWED_ORIGINS=http://localhost:5173,http://localhost:5174,https://campusify.net,https://rosita-waters-react.vercel.app
