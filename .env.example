# Copy to .env locally and set the values in your API host before deployment.
DATABASE_URI=mongodb+srv://<user>:<password>@<cluster>.mongodb.net/rarwater
PORT=5000
NODE_ENV=development

# Generate a private 32-byte value with: openssl rand -hex 32
JWT_SECRET=replace-with-at-least-64-random-hex-characters

# The owner account is created on first startup with a random unknown password.
# Use the admin sign-in page's "Forgot password?" flow to set its password.
OWNER_EMAIL=owner@example.com

# Protects backend-only client onboarding APIs. Generate a unique 32-byte secret.
PLATFORM_ADMIN_API_KEY=replace-with-at-least-64-random-hex-characters

# The first tenant. Supply its bare domain names (no scheme or path).
DEFAULT_TENANT_KEY=rosita-waters
DEFAULT_TENANT_NAME=Rosita Waters
DEFAULT_TENANT_DOMAINS=rositawaters.com,www.rositawaters.com,rosita-waters-react.vercel.app,rosita-waters.vercel.app

# Cloudinary connection string from the Cloudinary dashboard
CLOUDINARY_URL=cloudinary://<api_key>:<api_secret>@<cloud_name>
TENANT_ROSITA_WATERS_CLOUDINARY_URL=cloudinary://<api_key>:<api_secret>@<cloud_name>

# Resend keys and sender addresses are selected by tenant and never sent to browsers.
TENANT_ROSITA_WATERS_RESEND_API_KEY=re_your-api-key
TENANT_ROSITA_WATERS_RESEND_FROM_EMAIL=admin@example.com
TENANT_ROSITA_WATERS_ORDER_NOTIFICATION_EMAIL=orders@example.com
TENANT_ROSITA_WATERS_WHATSAPP_ACCESS_TOKEN=replace-with-private-token
TENANT_ROSITA_WATERS_WHATSAPP_PHONE_NUMBER_ID=replace-with-phone-number-id
TENANT_ROSITA_WATERS_WHATSAPP_ORDER_RECIPIENT=2348000000000

# Comma-separated browser origins allowed to call this API
ALLOWED_ORIGINS=http://localhost:5173,http://localhost:3000,https://rositawaters.com,https://www.rositawaters.com,https://rosita-waters-react.vercel.app,https://rosita-waters.vercel.app,https://campusify.net
